<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Libreria della harness, SENZA dipendenze da Unity né da SDK esterni (Gemini è chiamato via HTTP).
    netstandard2.1 + C# 9 = compatibile con Unity (Mono / .NET Standard 2.1).
    La chiamata al modello passa dall'interfaccia ILlmClient.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>InterviewHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
